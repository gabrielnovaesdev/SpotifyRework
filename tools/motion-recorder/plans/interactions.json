  { "click": ".tabs-nav__button:nth-of-type(2)" },
  { "wait": 1500 },
  { "mark": "tab-ext" },
  { "click": ".tabs-nav__button:nth-of-type(3)" },
  { "wait": 1500 },
  { "eval": "document.querySelector('.testimonial-slider-wrap').scrollIntoView({block:'center'})" },
  { "wait": 1500 },
  { "mark": "drag" },
  { "drag": ".testimonial-slider-item", "dx": -500, "ms": 500 },
  { "wait": 1800 },
  { "mark": "drag-back" },
  { "drag": ".testimonial-slider-item", "dx": 400, "ms": 400 },
