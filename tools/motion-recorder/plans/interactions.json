[
  { "mark": "entrance" },
  { "wait": 3500 },
  { "eval": "[...document.querySelectorAll('button,a')].find(b=>/^(deny|reject all|decline|reject)$/i.test(b.textContent.trim()))?.click()" },
  { "mark": "header-down" },
  { "wheel": 500, "ms": 700 },
  { "wait": 900 },
  { "mark": "header-up" },
  { "wheel": -150, "ms": 300 },
  { "wait": 1000 },
  { "mark": "header-down-2" },
  { "wheel": 300, "ms": 400 },
  { "wait": 900 },
  { "mark": "menu-open" },
  { "click": "#menuButton" },
  { "wait": 1400 },
  { "mark": "menu-close" },
  { "click": "#menuButton" },
  { "wait": 1200 },
  { "eval": "document.querySelector('.centered-slider-group').scrollIntoView({block:'center'})" },
  { "wait": 1500 },
  { "mark": "carousel-auto" },
  { "wait": 9000 },
  { "mark": "carousel-bullet" },
  { "eval": "document.querySelectorAll('.centered-slider-bullet')[2].click()" },
  { "wait": 1600 },
